
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>VALORANT エージェント一覧</title>
</head>
<body>
  <h2>VALORANT エージェント一覧</h2>

  <table border="1">
    <tr>
      <th>ID</th>
      <th>エージェント名</th>
      <th>ロール</th>
    </tr>

    <% for (let row of data) { %>
      <tr>
        <td><%= row.id %></td>
        <td><%= row.name %></td>
        <td><%= row.role %></td>
      </tr>
    <% } %>
  </table>
</body>
</html>
